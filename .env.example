# Copy to .env and fill in only the engines you want to use.

# --- Local engine (no key needed) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Cloud engines (optional) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=

DEEPSEEK_API_KEY=

MOONSHOT_API_KEY=

# --- Jarvis app ---
# Random string used to derive the local encryption key for memory.
# If empty, a key file is generated automatically on first run.
JARVIS_SECRET=

# Backend
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# --- Agent safety / loop protection ---
# Hard limits applied to every reasoning + tool loop. Conservative defaults.
JARVIS_MAX_AGENT_LOOPS=10
JARVIS_MAX_TOOL_CALLS=25
JARVIS_MAX_AGENT_RUNTIME_SECONDS=120
JARVIS_MAX_IDENTICAL_ERRORS=3
JARVIS_MAX_IDENTICAL_PLANS=3

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8765
