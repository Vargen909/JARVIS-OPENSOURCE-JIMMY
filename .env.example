# Copy to .env and fill in only the engines you want to use.

# --- Local engine (no key needed) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Cloud engines (optional) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=

DEEPSEEK_API_KEY=

MOONSHOT_API_KEY=

# --- B.O.B app ---
# Random string used to derive the local encryption key for memory.
# If empty, a key file is generated automatically on first run.
BOB_SECRET=

# Backend
BOB_HOST=127.0.0.1
BOB_PORT=8765

# --- Agent safety / loop protection ---
# Hard limits applied to every reasoning + tool loop. Conservative defaults.
BOB_MAX_AGENT_LOOPS=10
BOB_MAX_TOOL_CALLS=25
BOB_MAX_AGENT_RUNTIME_SECONDS=120
BOB_MAX_IDENTICAL_ERRORS=3
BOB_MAX_IDENTICAL_PLANS=3

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8765

# ─────────────────────────────────────────────────────────────────────
# Legacy JARVIS_* variables are still honored as fallbacks for backwards
# compatibility but new installations should use BOB_* names above.
# ─────────────────────────────────────────────────────────────────────
